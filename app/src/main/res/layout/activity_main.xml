<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/navy_primary">

    <!-- Top Navy Header Banner -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@color/navy_primary">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRACTICAL 7 — CS7035"
            android:textColor="@color/ice_mint_dark"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Directory"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvHeaderSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage and search student information"
            android:textColor="#D4E1F0"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_main">

        <!-- PAGE 1: STUDENT DIRECTORY / LIST PAGE -->
        <FrameLayout
            android:id="@+id/layoutRecordsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp">

                <!-- Search & Counter Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_card_mint"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Search by name, enrolment or course..."
                        android:singleLine="true"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:background="@drawable/input_background" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0 records found"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_mint_chip"
                            android:text="SQLite Storage"
                            android:textColor="@color/teal_dark"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Student Records List -->
                <ListView
                    android:id="@+id/listStudents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:clipToPadding="false"
                    android:paddingBottom="70dp" />
            </LinearLayout>

            <!-- Empty State Layout -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Student Records"
                    android:textColor="@color/navy_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Click the button below to register your first student."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFirstStudent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Student"
                    app:backgroundTint="@color/teal_primary"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <!-- Floating Action Button to Add Student -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddStudent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="Add Student"
                app:srcCompat="@drawable/ic_add_student"
                app:backgroundTint="@color/teal_primary"
                app:tint="@color/white" />
        </FrameLayout>


        <!-- PAGE 2: ADD / EDIT STUDENT FORM PAGE -->
        <ScrollView
            android:id="@+id/layoutFormPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Form Mode Banner -->
                <LinearLayout
                    android:id="@+id/layoutEditModeBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_mint_chip"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvModeBannerText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Editing Student Record"
                        android:textColor="@color/teal_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCancelEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Cancel Edit"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/navy_primary"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_card_mint">

                    <TextView
                        android:id="@+id/tvFormTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Student Registration Details"
                        android:textColor="@color/navy_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter full name"
                        android:singleLine="true"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:background="@drawable/input_background"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15-Digit Enrolment Number"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etEnrollment"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter 15 digits"
                        android:singleLine="true"
                        android:inputType="number"
                        android:maxLength="15"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:background="@drawable/input_background"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date of Birth"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Select date of birth (Past date)"
                        android:focusable="false"
                        android:clickable="true"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:background="@drawable/input_background"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10-Digit Contact Number"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etContact"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter 10 digits"
                        android:singleLine="true"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:background="@drawable/input_background"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Course"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spCourse"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_background"
                        android:paddingHorizontal="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semester"
                        android:textColor="@color/navy_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spSemester"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_background"
                        android:paddingHorizontal="8dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Form Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Save Record"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/teal_primary"
                            app:cornerRadius="10dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdate"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Update"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            app:backgroundTint="@color/teal_primary"
                            app:cornerRadius="10dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDelete"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Delete"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            app:backgroundTint="@color/red_delete"
                            app:cornerRadius="10dp"
                            android:layout_marginStart="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClear"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Clear"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/ice_mint"
                            android:textColor="@color/teal_dark"
                            app:cornerRadius="10dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:itemRippleColor="@color/ice_mint"
        app:indicatorColor="@color/teal_primary"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>